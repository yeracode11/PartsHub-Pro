# Заявки приходят сообщением в Telegram от вашего бота.
# 1) В Telegram откройте @BotFather → /newbot → скопируйте токен в TELEGRAM_BOT_TOKEN.
# 2) Напишите своему боту любое сообщение (для группы — добавьте бота в группу).
# 3) Откройте https://api.telegram.org/bot<токен>/getUpdates и возьмите chat.id в TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Дополнительно: пересылать заявки (CRM, Zapier/Make и т.п.). Принимает POST с JSON.
# Необязательно; можно вместе с Telegram.
LEAD_WEBHOOK_URL=

# Публичный адрес сайта без слэша на конце (canonical, Open Graph, sitemap, robots).
# Пока не задан — сайт закрыт от индексации (noindex + Disallow: /).
NEXT_PUBLIC_SITE_URL=
