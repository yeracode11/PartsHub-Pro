# Скопируйте этот файл в .env рядом с ним (он в .gitignore и в репозиторий не попадает):
#   cp .env.example .env
# Затем отредактируйте значения под сервер или локально.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Публичный URL API (для ссылок на загрузки изображений в B2C). На продакшене — http(s)://ваш-хост:порт
API_BASE_URL=http://108.174.78.106:3000

# PostgreSQL — либо отдельные переменные, либо одна строка DATABASE_URL (приоритетнее парсится в коде)
PORT=3000
DATABASE_URL=postgres://partshub_user:erasoft123@localhost:5432/partshub
DB_USER=partshub_user
DB_PASSWORD=erasoft123
DB_NAME=partshub
DB_PORT=5432
DB_SSL=false
JWT_SECRET=supersecret

JWT_SECRET=supersecret
CORS_ORIGIN=*

UPLOAD_DIR=./uploads

# Логи → Loki (опционально; если не нужно — можно не задавать)
LOG_LEVEL=info
LOKI_HOST=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_SERVICE_NAME=autohub-backend
LOKI_ENV=development

