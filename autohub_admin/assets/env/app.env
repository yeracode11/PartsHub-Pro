# Loaded at startup via flutter_dotenv (assets/env/app.env).
# Override without editing this file:
#   API_BASE_URL=https://your-host/api flutter run
# or:
#   flutter run --dart-define=API_BASE_URL=https://your-host/api
#
# Как в autohub_b2b/lib/config/environment.dart: полный URL с суффиксом /api.
# Dio в приложении обрезает /api и шлёт запросы на /api/... (совпадает с ApiClient B2B).
API_BASE_URL=http://108.174.78.106:3001/api
